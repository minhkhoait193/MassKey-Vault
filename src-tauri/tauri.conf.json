{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MassKey Vault",
  "version": "1.4.0",
  "identifier": "com.masskey.vault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MassKey Vault",
        "width": 1280,
        "height": 800,
        "minWidth": 700,
        "minHeight": 600,
        "backgroundColor": "#090a13",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh",
        "startMenuFolder": "MassKey Vault"
      }
    }
  }
}
